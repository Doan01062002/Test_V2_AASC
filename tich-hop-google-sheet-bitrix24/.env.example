# Server Configuration
PORT=3000
NODE_ENV=development

# Google Sheets API Configuration
# Option 1: Service Account JSON file path (relative to project root or absolute)
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Option 2: Credentials directly in environment variables (useful for cloud deployment)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Google Spreadsheet ID and Sheet name
GOOGLE_SPREADSHEET_ID=1FulIWv_CjZiq9dil9iYg5uu2iT-C5d0OLeAOFWrQbUc
GOOGLE_SHEET_NAME=Sheet1

# Bitrix24 CRM REST API Configuration
# Inbound Webhook URL (must end with /)
BITRIX24_WEBHOOK_URL=https://b24-lgjau5.bitrix24.vn/rest/1/x05gotm70jw0jfcg/
# Outbound Webhook Verification Token (optional, for validating incoming Bitrix24 events)
BITRIX24_OUTBOUND_TOKEN=

# Sync Engine & Scheduler Configuration
# Cron schedule for automated sync (e.g. */15 * * * * = every 15 minutes)
SYNC_CRON_SCHEDULE=*/15 * * * *
# Rate limiter: requests per second for Bitrix24 API (Bitrix24 cloud limit is 2 req/s)
RATE_LIMIT_RPS=2
# Exponential backoff max retries (default: 3)
MAX_RETRIES=3
# Batch chunk size for processing
BATCH_SIZE=50

# Database Configuration (SQLite TypeORM)
DATABASE_FILE=data/sync.sqlite
